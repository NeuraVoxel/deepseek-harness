{
  "extends": "../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    // The Host half and its specs use Node builtins; the client entry keeps the
    // browser lib from the base and never imports them.
    "types": ["client-build-environment", "node"]
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../vendor/cordis"
    },
    {
      "path": "../../packages/api/session-controller/tsconfig.client.json"
    },
    {
      "path": "../../packages/client/locale"
    },
    {
      "path": "../../packages/client/ui-conversation"
    },
    {
      "path": "../../packages/client/ui-renderer"
    },
    {
      "path": "../../packages/client/ui-slots"
    },
    {
      "path": "../../packages/storage/storage"
    },
    {
      "path": "../../packages/storage/storage-domain"
    },
    {
      "path": "../../packages/storage/storage-json"
    }
  ]
}
