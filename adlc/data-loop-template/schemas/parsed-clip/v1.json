{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/parsed-clip/v1.json",
  "title": "ParsedClip",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clip_id",
    "schema_version",
    "vehicle_id",
    "captured_at",
    "sensors",
    "parsed"
  ],
  "properties": {
    "clip_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "const": "clip-metadata/v1" },
    "vehicle_id": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "modality"],
        "properties": {
          "name": { "type": "string" },
          "modality": { "type": "string", "enum": ["camera", "lidar", "radar", "ins"] }
        }
      }
    },
    "object_uri": { "type": "string" },
    "parsed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_count", "duration_ms", "norm_uri"],
      "properties": {
        "frame_count": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "norm_uri": { "type": "string", "minLength": 1 }
      }
    }
  }
}
