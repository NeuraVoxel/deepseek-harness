{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/dataset-revision/v1.json",
  "title": "DatasetRevision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision_id",
    "schema_version",
    "dataset_id",
    "created_at",
    "clip_ids",
    "parent_revision_ids"
  ],
  "properties": {
    "revision_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "const": "dataset-revision/v1" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "clip_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "parent_revision_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "lineage_note": { "type": "string" }
  }
}
