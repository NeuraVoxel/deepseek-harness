{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/clip-metadata/v1.json",
  "title": "ClipMetadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["clip_id", "schema_version", "vehicle_id", "captured_at", "sensors"],
  "properties": {
    "clip_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "const": "clip-metadata/v1" },
    "vehicle_id": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "modality"],
        "properties": {
          "name": { "type": "string" },
          "modality": { "type": "string", "enum": ["camera", "lidar", "radar", "ins"] }
        }
      }
    },
    "object_uri": { "type": "string" }
  }
}
