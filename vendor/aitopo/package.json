{
  "name": "@neuravoxel/aitopo",
  "description": "Canvas topology engine for AI graphs (Document/Patch/Events + dirty-rect Network)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/types/**/*.js",
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b",
    "demo": "vite --config demo/vite.config.ts"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "vite": "^6.3.5",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
